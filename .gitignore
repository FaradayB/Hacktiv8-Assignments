# --- Secrets -----------------------------------------------------------------
# Matches a file named .env at ANY depth. The previous version listed explicit
# paths that silently matched nothing (wrong folder names / missing the plural
# "Mini Projects" prefix), which is how real API keys ended up committed.
# Keep this name-based, never path-based.
.env
.env.local

# Templates are safe to commit
!.env.example

# --- Python ------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo

# --- Generated artifacts -----------------------------------------------------
chroma_db/
*.save

# --- Editor ------------------------------------------------------------------
.vscode/
.ipynb_checkpoints/
